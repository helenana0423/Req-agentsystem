# ReqBoard 配置示例
# 复制为 .env 使用（项目根目录）

# ========== LLM 配置 ==========
# 是否启用真实 LLM（false 时前端使用本地规则引擎）
LLM_ENABLED=false

# 选择：openai / deepseek / anthropic
LLM_PROVIDER=openai

# 模型名
LLM_MODEL=gpt-4o-mini

# 抽取专用模型（可选，不填则用 LLM_MODEL）
# LLM_EXTRACT_MODEL=gpt-4o

# API Key
LLM_API_KEY=

# 自定义 API 地址（可选，DeepSeek 默认会自动填，走代理才需要）
# LLM_BASE_URL=https://api.openai.com/v1

# 超时秒数
LLM_TIMEOUT=60
